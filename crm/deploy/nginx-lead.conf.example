# Приём заявок с сайта. Вставить в server-блок karatsapov.ru — тот, что
# отдаёт статику из /var/www/landing.
#
# Зачем проксировать с основного домена, а не слать сразу на crm.karatsapov.ru:
# запрос остаётся на том же домене, браузер не делает предварительный запрос
# CORS, и его не режут блокировщики межсайтовых POST. На форме заявок это
# прямые потери, поэтому путь выбран такой.

location = /api/lead {
    # Сервис слушает только локально, наружу его отдаёт этот блок.
    proxy_pass http://127.0.0.1:8787/api/lead;

    proxy_set_header Host $host;
    # Без этого заголовка сервис увидит адрес Nginx, а не посетителя,
    # и ограничение частоты станет общим на всех сразу.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Origin $http_origin;

    # Заявка — это пара килобайт. Больше принимать незачем.
    client_max_body_size 32k;

    # Сервис сам ждёт MAX не дольше восьми секунд.
    proxy_read_timeout 15s;

    # Грубая отсечка потока на уровне Nginx, до приложения.
    # Зону объявить один раз в http-блоке:
    #   limit_req_zone $binary_remote_addr zone=lead:10m rate=10r/m;
    limit_req zone=lead burst=5 nodelay;
}
