# systemd-юнит сервиса. Положить в /etc/systemd/system/crm.service
#
#   systemctl daemon-reload && systemctl enable --now crm
#   journalctl -u crm -f          — смотреть лог
#
# Настройки лежат в /etc/crm.env, который виден только root
# (chmod 600 /etc/crm.env):
#
#   CRM_DATA=/var/lib/crm/base.ndjson
#   CRM_SECRET=длинная-случайная-строка
#
#   # вход через Яндекс ID
#   CRM_YANDEX_CLIENT_ID=...
#   CRM_YANDEX_CLIENT_SECRET=...
#   CRM_BASE_URL=https://crm.karatsapov.ru
#   CRM_ALLOWED_EMAILS=вы@yandex.ru
#
#   # запасной вход по паролю (можно не задавать)
#   CRM_PASSWORD=длинный-пароль

[Unit]
Description=CRM: база компаний и проверка сайтов
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/crm
ExecStart=/usr/bin/node /opt/crm/server.mjs
EnvironmentFile=/etc/crm.env
Restart=always
RestartSec=3

# Сервис читает и пишет только свой каталог с базой. Остальная файловая
# система для него доступна только на чтение — ошибка в коде не сможет
# задеть сайт, который лежит рядом.
User=www-data
Group=www-data
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/crm

[Install]
WantedBy=multi-user.target
