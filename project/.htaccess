# Конфигурация Apache для обычного (виртуального) хостинга.
#
# Сайт статический: ни PHP, ни базы на сервере не нужно. Всё, что делает
# этот файл — канонический адрес, своя страница 404 и кэш.
#
# На GitHub Pages и на nginx файл просто игнорируется, так что держать его
# в сборке безопасно.

AddDefaultCharset UTF-8

# ── Канонический адрес ────────────────────────────────────────────────
# Одним правилом сразу и http → https, и www → без www: два отдельных
# правила дают две перенаправки подряд, а это лишний круг для робота
# и для посетителя.
# При смене домена поменять karatsapov.ru здесь.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://karatsapov.ru%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Индексные файлы и слэш ────────────────────────────────────────────
# Страницы лежат каталогами: /ceny/index.html. DirectorySlash дописывает
# слэш к /ceny, иначе относительные пути внутри страницы поедут.
DirectoryIndex index.html
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>
Options -Indexes

# ── Своя страница 404 ─────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Сжатие ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Кэш ───────────────────────────────────────────────────────────────
# Имена файлов в сборке не хешируются: dark.css остаётся dark.css после
# каждой правки. Поэтому долгий кэш ставим только на то, что почти не
# меняется, а стили и скрипты держим на коротком — иначе посетители будут
# неделями видеть старую вёрстку.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 hour"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType text/css              "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/jpeg            "access plus 7 days"
  ExpiresByType image/png             "access plus 7 days"
  ExpiresByType image/webp            "access plus 7 days"
  ExpiresByType image/svg+xml         "access plus 7 days"
  ExpiresByType font/woff2            "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
